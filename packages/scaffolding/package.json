{
  "name": "@dezkareid/scaffolding",
  "version": "0.0.0",
  "type": "module",
  "description": "Standardize and automate the creation of new software projects",
  "main": "./dist/index.js",
  "bin": {
    "scaffolding": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dezkareid/dezkareid.git",
    "directory": "packages/scaffolding"
  },
  "homepage": "https://github.com/dezkareid/dezkareid/tree/main/packages/scaffolding#readme",
  "bugs": {
    "url": "https://github.com/dezkareid/dezkareid/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "test": "vitest --run",
    "start": "node dist/index.js"
  },
  "keywords": [
    "scaffolding",
    "cli",
    "template",
    "dezkareid"
  ],
  "author": "Joel Humberto Gomez Paredes <elmaildeldezkareid@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.7.1",
  "devDependencies": {
    "@dezkareid/eslint-config-ts-base": "workspace:^",
    "@dezkareid/eslint-plugin-web": "workspace:^",
    "@types/fs-extra": "11.0.4",
    "@types/node": "25.5.2",
    "@types/prompts": "^2.4.9",
    "eslint": "10.2.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vitest": "4.1.2"
  },
  "dependencies": {
    "commander": "12.0.0",
    "execa": "9.6.1",
    "fs-extra": "11.2.0",
    "picocolors": "1.1.1",
    "prompts": "2.4.2"
  }
}