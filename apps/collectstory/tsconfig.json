{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@testing-library/react": [
        "../../node_modules/.pnpm/node_modules/@testing-library/react"
      ],
      "@testing-library/user-event": [
        "../../node_modules/.pnpm/node_modules/@testing-library/user-event"
      ],
      "@testing-library/jest-dom": [
        "../../node_modules/.pnpm/node_modules/@testing-library/jest-dom"
      ],
      "@testing-library/jest-dom/vitest": [
        "../../node_modules/.pnpm/node_modules/@testing-library/jest-dom/vitest"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/types/validator.ts",
    ".next/dev/types/validator.ts"
  ]
}
