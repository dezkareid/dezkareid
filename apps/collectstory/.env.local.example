# =============================================================================
# Collectstory — Local Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.

# -----------------------------------------------------------------------------
# Supabase
# Source: Supabase dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Project URL (public — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/publishable key (public — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Secret key (server-side only, never expose to the browser)
# Source: Supabase dashboard → Project Settings → API → Secret key (sb_secret_*)
SUPABASE_SECRET_KEY=your-supabase-secret-key

# -----------------------------------------------------------------------------
# Cloudinary
# Source: Cloudinary dashboard → Settings → Account
# Used for server-side image uploads (collection items and avatars)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# App
# The public base URL of the application (used for sitemaps and canonical URLs)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
