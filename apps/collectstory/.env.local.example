# =============================================================================
# Collectstory — Local Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.

# -----------------------------------------------------------------------------
# Supabase
# Source: Supabase dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Project URL (public — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/publishable key (public — safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Service role key (secret — server-side only, never expose to the browser)
# Source: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Cloudinary
# Source: Cloudinary dashboard → Settings → Account → Cloud name
# NOTE: Not yet provisioned. Set to a placeholder until the account is ready.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=placeholder
