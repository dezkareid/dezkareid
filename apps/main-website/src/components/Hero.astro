---
import Section from "./Section.astro";

interface Properties {
  subtitle?: string;
}

const {
  subtitle = "Helping companies and engineering teams build scalable, performant, and maintainable frontend architectures. I specialize in React ecosystem, design systems, and mentoring developers to reach their full potential.",
} = Astro.props;
---

<Section paddingBlock="large" class="hero">
  <div class="hero__container">
    <h1 class="hero__title">
      Crafting frontend products and experiences that scale.
    </h1>

    <div class="hero__body">
      <div class="hero__avatar-wrap">
        <img
          src="https://res.cloudinary.com/ddyovtxd2/image/upload/w_150,h_150,c_fill,g_face,q_auto,f_auto/v1773092115/JOEL_GOMEZ-4_viqymi.jpg"
          srcset="
            https://res.cloudinary.com/ddyovtxd2/image/upload/w_150,h_150,c_fill,g_face,q_auto,f_auto/v1773092115/JOEL_GOMEZ-4_viqymi.jpg 1x,
            https://res.cloudinary.com/ddyovtxd2/image/upload/w_300,h_300,c_fill,g_face,q_auto,f_auto/v1773092115/JOEL_GOMEZ-4_viqymi.jpg 2x
          "
          sizes="150px"
          alt="Joel Gomez"
          class="hero__avatar"
          width="150"
          height="150"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="hero__content">
        <p class="hero__subtitle">{subtitle}</p>
        <a href="/about" class="hero__link">
          About me <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</Section>

<style>
  .hero {
    /* Skin */
    background: linear-gradient(
      135deg,
      var(--color-background-primary) 0%,
      color-mix(
          in srgb,
          var(--color-primary) 5%,
          var(--color-background-primary)
        )
        100%
    );
  }

  .hero__container {
    /* Layout */
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: var(--spacing-24);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-48);
  }

  .hero__title {
    /* Skin */
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-align: center;
    
    /* Layout */
    margin: 0;
  }

  /* Mobile: avatar above subtitle, stacked */
  .hero__body {
    /* Layout */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-32);
    width: 100%;
  }

  .hero__content {
    /* Layout */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-24);
  }

  .hero__avatar-wrap {
    /* Layout */
    flex-shrink: 0;
  }

  .hero__avatar {
    /* Skin */
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: 3px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
    
    /* Layout */
    width: 150px;
    height: 150px;
    display: block;
  }

  .hero__subtitle {
    /* Skin */
    font-size: var(--font-size-400);
    color: var(--color-text-primary);
    line-height: var(--font-line-height-relaxed);
    text-align: center;
    
    /* Layout */
    margin: 0;
    max-width: 48ch;
  }

  .hero__link {
    /* Skin */
    color: var(--color-primary);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-300);
    text-decoration: none;
    transition: gap 0.2s ease;
    
    /* Layout */
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-8);
  }

  .hero__link:hover {
    gap: var(--spacing-12);
    text-decoration: none;
  }

  /* ≥600px: avatar left, text right */
  @media (min-width: 37.5rem) {
    .hero__body {
      flex-direction: row;
      align-items: center;
      gap: var(--spacing-48);
    }

    .hero__content {
      align-items: flex-start;
    }

    .hero__subtitle {
      text-align: left;
      max-width: 40ch;
    }
  }

  /* XL: title left-aligned, no inline padding */
  @media (min-width: 90rem) {
    .hero__container {
      align-items: flex-start;
      padding-inline: 0;
    }

    .hero__title {
      text-align: left;
    }
  }
</style>
