---
import Card from "./Card.astro";
import type { CollectionEntry } from 'astro:content';

interface Properties {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { title, description, icon } = service.data;
---

<Card class="service-card">
  <!-- Stretched link covers the full card -->
  <a
    class="service-card__link"
    href={`/services/${service.id}`}
    aria-label={`Learn about ${title}`}
    data-ga-event="view_service"
    data-ga-params={JSON.stringify({ service_id: service.id, title })}
  >
  </a>

  <div class="service-card__header">
    <span class="service-card__icon" aria-hidden="true">{icon || "⚙️"}</span>
    <h3 class="service-card__title">{title}</h3>
  </div>
  <p class="service-card__description">{description}</p>
</Card>

<style>
  /* ====================================================
     DESIGN TOKEN ANNOTATIONS
     - --color-icon-bg: color-mix(primary, bg-secondary) for icon containers
     - --size-icon-lg: 3rem for large decorative icons
     ==================================================== */

  .service-card {
    /* Layout */
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;

    /* Skin / Behavioral */
    cursor: pointer;
  }

  /* Stretched link — covers the full card */
  .service-card__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .service-card::before {
    /* Top accent bar — DS NOTE: --color-accent-bar candidate */
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-primary),
      color-mix(in srgb, var(--color-primary) 40%, transparent)
    );
    border-radius: var(--spacing-8) var(--spacing-8) 0 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .service-card__header {
    /* Layout */
    display: flex;
    align-items: center;
    gap: var(--spacing-12);
    margin-bottom: var(--spacing-12);
  }

  .service-card__icon {
    /* Skin */
    font-size: var(--font-size-700);
    line-height: 1;

    /* Layout */
    flex-shrink: 0;
  }

  .service-card__title {
    /* Skin */
    font-size: var(--font-size-500);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;

    /* Layout */
    margin: 0;
  }

  .service-card__description {
    /* Skin */
    font-size: var(--font-size-300);
    /* Use text-primary for sufficient contrast on secondary backgrounds */
    color: var(--color-text-primary);
    opacity: 0.75;
    line-height: var(--font-line-height-relaxed);

    /* Layout */
    flex: 1;
  }
</style>
