{
  "name": "@dezkareid/components",
  "version": "0.0.0",
  "type": "module",
  "description": "A package to export UI components in formats like React, Astro, Vue, etc.",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react-server": {
      "types": "./dist/react-server/index.d.ts",
      "import": "./dist/react-server/index.js",
      "default": "./dist/react-server/index.js"
    },
    "./react-client": {
      "types": "./dist/react-client/index.d.ts",
      "import": "./dist/react-client/index.js",
      "default": "./dist/react-client/index.js"
    },
    "./astro": "./src/astro/index.ts",
    "./vue": "./src/vue/index.ts",
    "./angular": {
      "types": "./dist/angular/types/dezkareid-components.d.ts",
      "import": "./dist/angular/fesm2022/dezkareid-components.mjs",
      "default": "./dist/angular/fesm2022/dezkareid-components.mjs"
    },
    "./css": {
      "import": "./dist/components.min.css",
      "default": "./dist/components.min.css"
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "react-server": [
        "./dist/react-server/index.d.ts"
      ],
      "react-client": [
        "./dist/react-client/index.d.ts"
      ],
      "angular": [
        "./dist/angular/types/dezkareid-components.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dezkareid/dezkareid"
  },
  "author": "Joel Humberto Gomez Paredes <elmaildeldezkareid@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dezkareid/dezkareid/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-system",
    "components",
    "react",
    "astro",
    "vue"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs && pnpm build:angular",
    "build:angular": "ng-packagr -p ng-package.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run --config vitest.config.mts"
  },
  "peerDependencies": {
    "@angular/common": ">=21.0.0",
    "@angular/compiler": ">=21.0.0",
    "@angular/core": ">=21.0.0",
    "@dezkareid/design-tokens": "1.6.0",
    "@dezkareid/icons": "1.4.0",
    "astro": ">=6.0.0",
    "classnames": "2.5.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "@angular/compiler": {
      "optional": true
    }
  },
  "dependencies": {
    "@dezkareid/design-tokens": "1.6.0",
    "@dezkareid/icons": "1.4.0",
    "classnames": "2.5.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "1.10.3",
    "@analogjs/vitest-angular": "1.10.3",
    "@angular-devkit/architect": "0.1902.5",
    "@angular/build": "21.2.5",
    "@angular/compiler-cli": "21.2.0",
    "@angular/platform-browser": "21.2.0",
    "@angular/platform-browser-dynamic": "21.2.0",
    "@dezkareid/eslint-config-ts-base": "1.0.0",
    "@dezkareid/eslint-plugin-web": "1.0.0",
    "@eslint-react/eslint-plugin": "2.13.0",
    "@eslint/js": "9.39.2",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.5.2",
    "@types/classnames": "2.3.4",
    "@types/node": "25.0.10",
    "@types/react": "19.2.9",
    "@vitejs/plugin-react": "5.1.4",
    "astro": "6.0.6",
    "eslint": "9.39.2",
    "jsdom": "28.0.0",
    "ng-packagr": "21.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rollup": "4.56.0",
    "rollup-plugin-postcss": "4.0.2",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.18",
    "zone.js": "0.15.0"
  }
}