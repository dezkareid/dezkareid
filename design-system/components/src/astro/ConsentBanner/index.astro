---
import { Button } from '../index';
import type { ConsentBannerProperties } from '../../shared/types/consent-banner';
import styles from '../../css/consent-banner.module.css';

interface Properties extends ConsentBannerProperties {
  [key: string]: unknown;
}

const {
  message = 'We use cookies to understand how you use our services and to improve your experience.',
  acceptLabel = 'Accept',
  declineLabel = 'Decline',
  class: className,
} = Astro.props;
---

<div id="consent-banner" class:list={[styles['consent-banner'], className]} role="alert" aria-live="polite" style="display: none;">
  <div class={styles['consent-banner__content']}>
    <p class={styles['consent-banner__text']}>
      {message}
    </p>
    <div class={styles['consent-banner__actions']}>
      <Button variant="ghost" size="sm" id="consent-decline">
        {declineLabel}
      </Button>
      <Button variant="primary" size="sm" id="consent-accept">
        {acceptLabel}
      </Button>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('consent-banner');
  const acceptBtn = document.getElementById('consent-accept');
  const declineBtn = document.getElementById('consent-decline');

  if (banner && acceptBtn && declineBtn) {
    const consent = localStorage.getItem('ga_consent');

    if (consent === null) {
      setTimeout(() => {
        banner.style.display = 'block';
      }, 3000);
    }

    acceptBtn.addEventListener('click', () => {
      localStorage.setItem('ga_consent', 'true');
      banner.style.display = 'none';
      window.location.reload();
    });

    declineBtn.addEventListener('click', () => {
      localStorage.setItem('ga_consent', 'false');
      banner.style.display = 'none';
    });
  }
</script>
