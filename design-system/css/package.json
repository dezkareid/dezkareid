{
  "name": "@dezkareid/css",
  "version": "0.0.0",
  "type": "module",
  "description": "Common CSS tools and utilities for dezkareid",
  "main": "dist/main.css",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dezkareid/dezkareid.git",
    "directory": "design-system/css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm run build:scss && pnpm run build:css",
    "build:scss": "npx sass src:dist --no-source-map",
    "build:css": "node scripts/build-css.js",
    "test": "pnpm run build",
    "lint": "echo \"No linting defined for SCSS yet\""
  },
  "keywords": [
    "css",
    "scss",
    "itcss",
    "design-system",
    "reset",
    "utilities"
  ],
  "author": "dezkareid",
  "license": "ISC",
  "peerDependencies": {
    "@dezkareid/design-tokens": "1.5.0"
  },
  "devDependencies": {
    "lightningcss": "1.29.1",
    "sass": "1.85.1"
  }
}